# Copy this file to .env and replace every placeholder.
# .env is ignored by Git and must never be committed.
ZEROTIER_API_TOKEN=replace-with-a-newly-rotated-zerotier-token
ZEROTIER_NETWORK_ID=replace-with-network-id
ZEROTIER_MEMBER_ID=replace-with-member-id
# auto prefers IPv6 and falls back to IPv4; use 4 or 6 to require one family.
ZEROTIER_IP_VERSION=auto
# Store the base provider URL without flag or sr. The application adds the
# required format parameters independently for Clash and Shadowrocket.
UPSTREAM_SUBSCRIPTION_URL=https://your-existing-subscription.example/subscribe?token=replace-me
UPSTREAM_USER_AGENT=ClashMetaForAndroid/2.11.24
SHADOWROCKET_UPSTREAM_USER_AGENT=Shadowrocket/2.2.68
SUBSCRIPTION_TOKEN=replace-with-at-least-32-random-url-safe-characters
